{
  "name": "bowersinteractive",
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "make-win": "vite build && electron-builder --win --x64 --dir",
    "make-mac": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.picasso.timeline",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ]
  },
  "dependencies": {
    "ls": "^1.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "scripts": "^0.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "gh-pages": "^6.1.1",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true
  }
}
